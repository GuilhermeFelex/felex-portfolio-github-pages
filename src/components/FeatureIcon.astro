---
/**
 * Ícones SVG locais para as especialidades.
 * Mantê-los em um componente evita dependências e facilita trocar os desenhos depois.
 */
interface Props {
  name: string;
}

const { name } = Astro.props;
---

<svg class="feature-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
  {name === 'link' && <><path d="M10 13.8a4.6 4.6 0 0 0 6.5.1l2.1-2.1a4.6 4.6 0 0 0-6.5-6.5L10.9 6.5" /><path d="M14 10.2a4.6 4.6 0 0 0-6.5-.1l-2.1 2.1a4.6 4.6 0 0 0 6.5 6.5l1.2-1.2" /></>}
  {name === 'settings' && <><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1-2.2 2.2-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.5v.2h-3.2v-.2a1.7 1.7 0 0 0-1-1.5 1.7 1.7 0 0 0-1.9.3l-.1.1-2.2-2.2.1-.1a1.7 1.7 0 0 0 .3-1.9 1.7 1.7 0 0 0-1.5-1H5v-3.2h.2a1.7 1.7 0 0 0 1.5-1 1.7 1.7 0 0 0-.3-1.9l-.1-.1 2.2-2.2.1.1a1.7 1.7 0 0 0 1.9.3 1.7 1.7 0 0 0 1-1.5V3.5h3.2v.2a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.9-.3l.1-.1 2.2 2.2-.1.1a1.7 1.7 0 0 0-.3 1.9 1.7 1.7 0 0 0 1.5 1h.2V13h-.2a1.7 1.7 0 0 0-1.5 2Z" /></>}
  {name === 'brain' && <><path d="M9.3 4.2A3.5 3.5 0 0 0 4.5 7.4 3.5 3.5 0 0 0 4.9 14a3.7 3.7 0 0 0 3.8 5.9c1.5 0 2.7-.9 3.3-2.2" /><path d="M14.7 4.2a3.5 3.5 0 0 1 4.8 3.2 3.5 3.5 0 0 1-.4 6.6 3.7 3.7 0 0 1-3.8 5.9c-1.5 0-2.7-.9-3.3-2.2" /><path d="M12 4v16M7.4 9.2c1.1.1 2 .8 2.4 1.8M16.6 9.2c-1.1.1-2 .8-2.4 1.8" /></>}
  {name === 'cube' && <><path d="m12 3 8 4.5v9L12 21l-8-4.5v-9L12 3Z" /><path d="m4 7.5 8 4.5 8-4.5M12 12v9" /></>}
</svg>
