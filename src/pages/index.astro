---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import FeatureIcon from '../components/FeatureIcon.astro';
import SectionTitle from '../components/SectionTitle.astro';
import { expertise, projects, site, stack } from '../data/site';
import nextIcon from 'simple-icons/icons/nextdotjs.svg?raw';
import reactIcon from 'simple-icons/icons/react.svg?raw';
import typescriptIcon from 'simple-icons/icons/typescript.svg?raw';
import nodeIcon from 'simple-icons/icons/nodedotjs.svg?raw';
import postgresqlIcon from 'simple-icons/icons/postgresql.svg?raw';
import supabaseIcon from 'simple-icons/icons/supabase.svg?raw';
import dockerIcon from 'simple-icons/icons/docker.svg?raw';
import n8nIcon from 'simple-icons/icons/n8n.svg?raw';
import uipathIcon from 'simple-icons/icons/uipath.svg?raw';

const socialLinks = [
  { label: 'GitHub', href: site.social.github },
  { label: 'LinkedIn', href: site.social.linkedin },
  { label: 'Instagram', href: site.social.instagram }
].filter((item) => item.href);

// SVGs entram no HTML final durante a build, sem chamadas externas em produção.
const stackIcons: Record<string, string> = {
  'Next.js': nextIcon, React: reactIcon, TypeScript: typescriptIcon, 'Node.js': nodeIcon,
  PostgreSQL: postgresqlIcon, Supabase: supabaseIcon, Docker: dockerIcon, n8n: n8nIcon,
  UiPath: uipathIcon,
  OpenAI: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.2a4.2 4.2 0 0 1 6.8 4.9 4.2 4.2 0 0 1 1 7.7 4.2 4.2 0 0 1-6.2 4.6 4.2 4.2 0 0 1-7.4-2.8 4.2 4.2 0 0 1-1.7-7.5A4.2 4.2 0 0 1 12 3.2Zm0 3.1a1.1 1.1 0 0 0-1 1.5l1.2 2.1-2.4-.1a1.1 1.1 0 0 0-.7 2l2 1.3-2 1.3a1.1 1.1 0 0 0 .7 2l2.4-.1L11 18.7a1.1 1.1 0 0 0 2 1.1l1.2-2.1 1.2 2.1a1.1 1.1 0 0 0 2-1.1l-1.2-2.1 2.4.1a1.1 1.1 0 0 0 .7-2l-2-1.3 2-1.3a1.1 1.1 0 0 0-.7-2l-2.4.1L17.4 8a1.1 1.1 0 0 0-2-1.1l-1.2 2.1L13 6.9a1.1 1.1 0 0 0-1-.6Z" /></svg>',
  'Power Platform': '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6.5 10.5 3v7.5L3 14V6.5Zm8.5-3.5L21 7v7l-9.5-3.5V3ZM3 15l7.5-3.5V21L3 17.5V15Zm8.5-3.5L21 15v2.5L11.5 21v-9.5Z" /></svg>',
  AWS: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8h3l1.2 5L9.7 8h2.6l1.5 5L15 8h3l-2.7 8h-2.8l-1.1-3.8L10.3 16H7.5L4 8Zm3.6 9.2c3.6 1.3 7.1 1.3 10.7 0-.3 1.2-1.2 2.5-2.7 3.1-1.7.7-4.2.7-5.9 0-1.1-.5-1.8-1.5-2.1-3.1Z" /></svg>'
};

// Substitui os desenhos provisórios pelos logotipos usados na grade de tecnologias.
const officialStackIcons: Partial<typeof stackIcons> = {
  OpenAI: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22.282 9.821a6 6 0 0 0-.516-4.91a6.05 6.05 0 0 0-6.51-2.9A6.065 6.065 0 0 0 4.981 4.18a6 6 0 0 0-3.998 2.9a6.05 6.05 0 0 0 .743 7.097a5.98 5.98 0 0 0 .51 4.911a6.05 6.05 0 0 0 6.515 2.9A6 6 0 0 0 13.26 24a6.06 6.06 0 0 0 5.772-4.206a6 6 0 0 0 3.997-2.9a6.06 6.06 0 0 0-.747-7.073M13.26 22.43a4.48 4.48 0 0 1-2.876-1.04l.141-.081l4.779-2.758a.8.8 0 0 0 .392-.681v-6.737l2.02 1.168a.07.07 0 0 1 .038.052v5.583a4.504 4.504 0 0 1-4.494 4.494M3.6 18.304a4.47 4.47 0 0 1-.535-3.014l.142.085l4.783 2.759a.77.77 0 0 0 .78 0l5.843-3.369v2.332a.08.08 0 0 1-.033.062L9.74 19.95a4.5 4.5 0 0 1-6.14-1.646M2.34 7.896a4.5 4.5 0 0 1 2.366-1.973V11.6a.77.77 0 0 0 .388.677l5.815 3.354l-2.02 1.168a.08.08 0 0 1-.071 0l-4.83-2.786A4.504 4.504 0 0 1 2.34 7.872zm16.597 3.855l-5.833-3.387L15.119 7.2a.08.08 0 0 1 .071 0l4.83 2.791a4.494 4.494 0 0 1-.676 8.105v-5.678a.79.79 0 0 0-.407-.667m2.01-3.023l-.141-.085l-4.774-2.782a.78.78 0 0 0-.785 0L9.409 9.23V6.897a.07.07 0 0 1 .028-.061l4.83-2.787a4.5 4.5 0 0 1 6.68 4.66zm-12.64 4.135l-2.02-1.164a.08.08 0 0 1-.038-.057V6.075a4.5 4.5 0 0 1 7.375-3.453l-.142.08L8.704 5.46a.8.8 0 0 0-.393.681zm1.097-2.365l2.602-1.5l2.607 1.5v2.999l-2.597 1.5l-2.607-1.5Z" /></svg>',
  'Power Platform': '<img src="/images/brands/power-platform.svg" width="96" height="96" alt="" aria-hidden="true">',
  AWS: '<span class="aws-wordmark" aria-hidden="true">aws</span>'
};
Object.assign(stackIcons, officialStackIcons);
---

<BaseLayout
  title="Felex — Integração, Automação e Agentes de IA"
  description="Portfólio de Felex: integrações, automação, RPA, agentes de IA e produtos digitais para operações empresariais."
>
  <a class="skip-link" href="#conteudo">Ir para o conteúdo</a>
  <div class="page-shell" id="top">
    <Header />

    <main id="conteudo">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-kicker reveal">
          <span class="signal" aria-hidden="true"></span>
          <span>Integração · Automação · IA</span>
          <span class="hero-location">{site.location}</span>
        </div>

        <h1 id="hero-title" class="hero-title reveal">
          Eu construo sistemas que<br />
          <span>conectam, automatizam</span><br />
          e pensam.
        </h1>

        <div class="hero-bottom reveal">
          <p>
            Transformo processos complexos em operações digitais claras, conectando software,
            automação e inteligência artificial.
          </p>
          <div class="hero-actions">
            <a class="text-link" href="#projetos">
              Ver projetos
              <span aria-hidden="true">↘</span>
            </a>
            <a class="hero-contact" href="#contato">Contato <span aria-hidden="true">→</span></a>
          </div>
        </div>

        <div class="hero-visual reveal" aria-hidden="true">
          <div class="visual-orbit visual-orbit-one"></div>
          <div class="visual-orbit visual-orbit-two"></div>
          <div class="visual-core"><span>AI</span></div>
          <div class="visual-note visual-note-one"><i></i> Sistemas conectados</div>
          <div class="visual-note visual-note-two"><i></i> Fluxos em movimento</div>
        </div>

      </section>

      <section class="about section" id="sobre" aria-labelledby="about-title">
        <SectionTitle number="01" label="Sobre" />
        <div class="about-grid">
          <p id="about-title" class="about-lead reveal">
            Tecnologia só importa quando resolve o que está travando a operação.
          </p>
          <div class="about-copy reveal">
            <p>
              Sou desenvolvedor focado em integrações, RPA, agentes de IA e aplicações
              empresariais. Meu trabalho começa entendendo o processo — e termina com uma solução
              que as pessoas conseguem usar, manter e evoluir.
            </p>
            <p>
              Atuo entre negócio e engenharia: conecto APIs, ERPs, CRMs, marketplaces e modelos
              de IA para reduzir trabalho manual, organizar dados e criar novas capacidades.
            </p>
          </div>
        </div>
      </section>

      <section class="expertise section" id="especialidades" aria-labelledby="expertise-title">
        <SectionTitle number="02" label="Especialidades" />
        <h2 id="expertise-title" class="sr-only">Especialidades</h2>
        <div class="expertise-list">
          {expertise.map((item) => (
            <article class="expertise-item reveal">
              <FeatureIcon name={item.icon} />
              <div>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
              </div>
              <ul aria-label={`Tecnologias de ${item.title}`}>
                {item.tags.map((tag) => <li>{tag}</li>)}
              </ul>
            </article>
          ))}
        </div>
      </section>

      <section class="projects section" id="projetos" aria-labelledby="projects-title">
        <SectionTitle number="03" label="Produtos em desenvolvimento" />
        <div class="projects-intro reveal">
          <h2 id="projects-title">Soluções em desenvolvimento para operações reais.</h2>
          <p>Quatro frentes que combinam CRM, ERP, automação e IA aplicada à operação.</p>
        </div>

        <div class="project-list">
          {projects.map((project) => (
            <article class="project-item reveal">
              <div class="project-heading">
                <span class="item-number">{project.number}</span>
                <h3>{project.title}</h3>
              </div>
              <p>{project.description}</p>
              <ul class="project-tags" aria-label={`Tecnologias de ${project.title}`}>
                {project.tags.map((tag) => <li>{tag}</li>)}
              </ul>
              <!-- Sem métricas ou links públicos, o escopo deixa claro o que cada produto cobre. -->
              <p class="project-scope">Foco operacional: {project.scope}</p>
            </article>
          ))}
        </div>
        <p class="projects-evidence reveal">
          Repositórios públicos e experimentos disponíveis em
          <a href={site.social.github} target="_blank" rel="noreferrer">GitHub</a>.
        </p>
      </section>

      <section class="stack section" aria-labelledby="stack-title">
        <SectionTitle number="04" label="Stack atual" />
        <h2 id="stack-title" class="stack-title reveal">
          Ferramentas mudam.<br />
          <span>Critério permanece.</span>
        </h2>
        <ul class="stack-list reveal">
          {stack.map((technology) => (
            <li>
              <span class="stack-mark" data-brand={technology} set:html={stackIcons[technology]!}></span>
              {technology}
            </li>
          ))}
        </ul>
      </section>

      <section class="contact section" id="contato" aria-labelledby="contact-title">
        <div class="contact-eyebrow reveal">
          <span class="signal" aria-hidden="true"></span>
          <span>Disponível para novos projetos</span>
        </div>
        <h2 id="contact-title" class="contact-title reveal">
          Tem um processo que<br />pode funcionar melhor?
        </h2>
        <div class="contact-bottom reveal">
          <p>Vamos conversar sobre o problema antes de falar sobre a ferramenta.</p>
          <div class="contact-actions">
            <a class="contact-link" href={`mailto:${site.email}`}>
              Iniciar conversa
              <span aria-hidden="true">↗</span>
            </a>
            <a class="contact-email" href={`mailto:${site.email}`}>{site.email}</a>
            <span class="contact-location">{site.location} · disponível para trabalho remoto</span>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="footer-brand">
        <strong>FELEX</strong>
        <span>Build. Integrate. Automate.</span>
      </div>
      <div class="footer-links">
        {socialLinks.map((link) => (
          <a href={link.href} target="_blank" rel="noreferrer">{link.label}</a>
        ))}
      </div>
      <a href="#top">Voltar ao topo ↑</a>
    </footer>
  </div>

  <script>
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const elements = document.querySelectorAll<HTMLElement>('.reveal');

    if (reducedMotion) {
      elements.forEach((element) => element.classList.add('is-visible'));
    } else {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12 }
      );

      elements.forEach((element) => observer.observe(element));
    }
  </script>
</BaseLayout>
